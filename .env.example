# Copy to ".env" and adjust. Everything here is optional: all values can
# also be entered in the setup wizard of the web interface.

# Host port for direct access to the web interface (http://HOST-IP:PORT).
LANPROXY_UI_PORT=8080

# --- Values that pre-fill the setup wizard ---
#LANPROXY_BASE_DOMAIN=home.example.com
#LANPROXY_UI_SUBDOMAIN=proxy
#LANPROXY_ACME_EMAIL=you@example.com
#LANPROXY_ACME_STAGING=true
#LANPROXY_DNS_PROVIDER=cloudflare
#LANPROXY_DNS_RESOLVERS=1.1.1.1,9.9.9.9

# Secrets. They are used if the fields in the wizard are left empty and
# are never shown in the web interface.
#LANPROXY_ADMIN_PASSWORD=
# DNS provider credentials: LANPROXY_DNS_ENV_<NAME>=value passes the
# variable NAME to the provider, e.g. for Cloudflare:
#LANPROXY_DNS_ENV_CF_DNS_API_TOKEN=
