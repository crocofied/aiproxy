# Copy to ".env" to test real certificate issuance against the
# Let's Encrypt STAGING environment. Without this file the test uses a
# made-up domain: everything except the certificate is tested and
# Traefik serves its self-signed default certificate.

# A domain you own, managed by the DNS provider below.
#E2E_BASE_DOMAIN=lab.example.com
#E2E_ACME_EMAIL=you@example.com
#E2E_DNS_PROVIDER=cloudflare
# JSON object with the provider's environment variables.
#E2E_DNS_ENV={"CF_DNS_API_TOKEN":"..."}
